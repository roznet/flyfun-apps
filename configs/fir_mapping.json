    "LF": ["LFFF", "LFBB", "LFEE", "LFMM", "LFRR"],
    "EG": ["EGTT", "EGPX"],
    "ED": ["EDGG", "EDMM", "EDWW"],
    "EB": ["EBBU"],
    "EH": ["EHAA"],
    "EI": ["EISN"],
    "EL": ["ELLX"],
    "LI": ["LIMM", "LIRR"],
    "LS": ["LSAG", "LSAZ"],
    "LO": ["LOVV"],
    "LE": ["LECM", "LECB"],
    "LP": ["LPPC"],
    "LK": ["LKAA"],
    "ES": ["ESAA"],
    "EN": ["ENOR", "ENBD"],
    "EK": ["EKDK"],
    "EF": ["EFIN"],
    "EP": ["EPWW"],
    "LG": ["LGGG"],
    "LH": ["LHCC"],
    "LJ": ["LJLA"],
    "LR": ["LRBB"],
    "LB": ["LBSR"],
    "LC": ["LCCC"],
    "LT": ["LTAA", "LTBB"]
  }
}
