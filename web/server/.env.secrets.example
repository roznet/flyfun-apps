# Secrets for the env file next to this one: copy to .env.secrets (gitignored, mode 600).
# Plain configuration is in .env (see .env.example). shared.env_loader loads the chosen
# .env and then its .env.secrets sibling; pydantic settings read both files.
# In the owner's setup this file is sops-encrypted in the config repo and decrypted by
# syncfiles on the host that uses it: don't hand-edit it there.

# LangSmith (aviation agent tracing)
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# OpenAI (aviation agent LLM models)
OPENAI_API_KEY=your_openai_api_key_here
